/icons/*.svg
  Cache-Control: public, max-age=31536000, immutable

/og-image.png
  Cache-Control: public, max-age=604800

/*.html
  Cache-Control: public, max-age=3600

/feed.xml
  Cache-Control: public, max-age=3600

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Generated JSON API (icons-full.json, registry.json, categories.json).
# Not content-hashed, so it can't be immutable; cache for an hour and serve
# stale while revalidating so repeat browse sessions skip the re-download.
/api/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
